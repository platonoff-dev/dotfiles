{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 380,
  "control-center-height": 720,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "notifications": {
      "vexpand": true
    },
    "mpris": {
      "blacklist": [],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false
    },
    "backlight": {
      "label": "󰃞",
      "device": "intel_backlight",
      "min": 1
    },
    "buttons-grid": {
      "buttons-per-row": 6,
      "button-style": "circular",
      "actions": [
        {
          "label": "󰖔",
          "type": "toggle",
          "tooltip": "Dark mode",
          "active": true,
          "command": "darkman toggle",
          "update-command": "sh -c '[ \"$(darkman get)\" = dark ] && echo true || echo false'"
        },
        {
          "label": "󰖩",
          "type": "toggle",
          "tooltip": "Wi-Fi",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "tooltip": "Bluetooth",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰅶",
          "type": "toggle",
          "tooltip": "Caffeine — keep awake",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && pkill -x hypridle || (pgrep -x hypridle >/dev/null || setsid hypridle </dev/null >/dev/null 2>&1 &)'",
          "update-command": "sh -c 'pgrep -x hypridle >/dev/null && echo false || echo true'"
        },
        {
          "label": "󰍬",
          "type": "toggle",
          "tooltip": "Microphone",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && pamixer --default-source -u || pamixer --default-source -m'",
          "update-command": "sh -c 'pamixer --default-source --get-mute | grep -q false && echo true || echo false'"
        },
        {
          "label": "󰕾",
          "type": "toggle",
          "tooltip": "Audio output",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && pamixer -u || pamixer -m'",
          "update-command": "sh -c 'pamixer --get-mute | grep -q false && echo true || echo false'"
        },
        {
          "label": "󰖂",
          "type": "toggle",
          "tooltip": "Cloudflare WARP",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && warp-cli connect || warp-cli disconnect'",
          "update-command": "sh -c 'warp-cli status 2>/dev/null | grep -qE \"Status update: Connected$\" && echo true || echo false'"
        },
        {
          "label": "󰍹",
          "type": "button",
          "tooltip": "Configure displays",
          "command": "sh -c 'swaync-client --close-panel; nwg-displays'"
        }
      ]
    }
  }
}
