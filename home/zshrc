# ============================================================
# PATH
# ============================================================
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/go/bin" $path)
export PATH

# ============================================================
# oh-my-zsh
# ============================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                    # disabled — starship handles the prompt
DISABLE_AUTO_UPDATE="true"
DISABLE_MAGIC_FUNCTIONS="true"  # avoid pasting slowdown

plugins=(
    git
    sudo
    fzf
    command-not-found
    colored-man-pages
    zsh-autosuggestions
    zsh-syntax-highlighting
)

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ============================================================
# Environment
# ============================================================
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R --mouse'
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# ============================================================
# History
# ============================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt SHARE_HISTORY INC_APPEND_HISTORY

# ============================================================
# Aliases — modern unix tools
# ============================================================
alias ls='eza --group-directories-first'
alias ll='eza -la --git --group-directories-first'
alias la='eza -a --group-directories-first'
alias lt='eza --tree --level=2 --group-directories-first'
alias cat='bat --paging=never'
alias less='bat'
alias top='btm'
alias htop='btm'
alias du='dust'
alias df='duf'
alias ps='procs'
alias find='fd'
alias grep='rg'
alias diff='delta'

# Editor
alias vim='nvim'
alias v='nvim'

# Git
alias g='git'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gs='git status'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias glog='git log --oneline --graph --decorate'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ============================================================
# Tool integrations
# ============================================================
# zoxide — smarter cd (z / cd both work)
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"

# starship prompt
command -v starship >/dev/null && eval "$(starship init zsh)"

# fzf keybindings (Arch package layout)
[[ -r /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
[[ -r /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh

# ============================================================
# Local overrides (gitignored)
# ============================================================
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
